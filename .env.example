# Optional: xAI server-side key for sourced summaries and previews.
# Never expose this as a VITE_* variable.
XAI_API_KEY=

# Recommended on serverless hosting for a durable recap cache.
DATABASE_URL=

# Optional public hostname used to build PWA metadata in production.
VITE_PUBLIC_HOSTNAME=

# Server-only Google Cloud Translation API key (never prefix with VITE_).
# Requires Cloud Translation enabled in a Google Cloud project.
GOOGLE_TRANSLATE_API_KEY=
